# Core System Configuration
NODE_ENV=development
PORT=5000

# Backend Service API Gateway
BACKEND_HOST=localhost
BACKEND_PORT=5000

# Python FastAPI Classifier Service
CLASSIFIER_HOST=localhost
CLASSIFIER_PORT=8000
CLASSIFIER_SERVICE_URL=http://localhost:8000

# Microservices
EXTRACTION_SERVICE_URL=http://localhost:5001
EXTRACTION_MOCK_PORT=5001

STRUCTURING_SERVICE_URL=http://localhost:5002
STRUCTURING_MOCK_PORT=5002

VALIDATION_SERVICE_URL=http://localhost:5003
VALIDATION_MOCK_PORT=5003

# Python Engines
ENGINE3_SERVICE_URL=http://localhost:5004
ENGINE2_SERVICE_URL=http://localhost:5005

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=idp_db
DB_USER=postgres
DB_PASSWORD=postgres_dev_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Storage Configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# AI & OCR APIs
GROQ_API_KEY=your_groq_api_key_here
GROQ_ENABLED=true
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ENABLED=true

OCR_SPACE_API_KEY=your_ocr_space_api_key_here
OCR_SPACE_ENABLED=true
