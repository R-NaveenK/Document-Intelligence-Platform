# COR Extraction Engine Configuration Environment Variables
# Copy this file to .env or export variables in host environment

# Directory for raw .txt artifact persistence
COR_OUTPUT_DIR=./data/cor_extractions

# Temporary working directory for atomic file operations
COR_TEMP_DIR=./data/temp

# Maximum allowed file size in Megabytes (default: 50 MB)
COR_MAX_FILE_SIZE_MB=50

# Maximum allowed image pixels to prevent decompression bombs (default: 100,000,000)
COR_MAX_IMAGE_PIXELS=100000000

# Processing timeout in seconds (default: 120 seconds)
COR_PROCESSING_TIMEOUT_SECONDS=120

# PaddleOCR language model ('en', 'ch', etc.)
COR_OCR_LANGUAGE=en

# OCR Execution Device ('cpu' or 'gpu')
COR_OCR_DEVICE=cpu

# Enable PaddleOCR textline orientation angle classification (true/false)
COR_OCR_USE_ORIENTATION=true

# Enable MKL-DNN acceleration on supported CPU architecture (true/false)
COR_OCR_ENABLE_MKLDNN=false

# Image preprocessing controls
COR_PREPROCESSING_ENABLED=true
COR_CONTRAST_ENHANCEMENT=true
COR_DENOISE=false

# PDF rendering DPI resolution (default: 200)
COR_PDF_RENDER_DPI=200
COR_PDF_MIN_TEXT_CHARS=40
COR_PDF_MIN_ALPHANUMERIC_RATIO=0.45
COR_PDF_MAX_GARBAGE_RATIO=0.20
